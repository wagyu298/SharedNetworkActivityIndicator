use_frameworks!

target 'SharedNetworkActivityIndicator_Example' do
  platform :ios, '12.0'
  pod 'LiveObjectTracer', :git => 'https://github.com/wagyu298/LiveObjectTracer.git'
  pod 'SharedNetworkActivityIndicator', :path => '../'

  target 'SharedNetworkActivityIndicator_Tests' do
    inherit! :search_paths

    pod 'Specta'
    pod 'Expecta'
  end

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      end
    end
  end
end
